# Local LM Studio server, exposed through its OpenAI-compatible API.
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen3-14b
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=600

# Retrieval
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=corporate_knowledge
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_CACHE_DIR=
CHUNK_SIZE=700
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=8
RERANK_TOP_N=3
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
MIN_RERANK_SCORE=0

# UI
GRADIO_HOST=127.0.0.1
GRADIO_PORT=7860

# Optional LLM-as-a-Judge
JUDGE_MODEL=qwen3-14b

# Langfuse
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
